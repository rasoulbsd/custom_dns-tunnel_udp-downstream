# Multi-stage build for DNS Tunnel Client
FROM debian:bookworm-slim as builder

# Install dependencies for building Rust
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    build-essential \
    gcc \
    libc6-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install Rust using rustup (non-interactive)
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --default-toolchain stable && \
    chmod -R a+w $RUSTUP_HOME $CARGO_HOME

WORKDIR /app

# Copy manifest files
COPY Cargo.toml ./
COPY src ./src

# Cargo.lock will be generated automatically during build if it doesn't exist
# For reproducible builds, you can generate it first with: cargo generate-lockfile

# Build the client binary
RUN cargo build --release --bin client

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the binary from builder
COPY --from=builder /app/target/release/client /app/client

# Create config directory
RUN mkdir -p /app/config

# Expose local UDP port (default 5355)
EXPOSE 5355/udp

# Run as non-root
USER 1000:1000

ENTRYPOINT ["/app/client"]
CMD ["--config", "/app/config/client-config.json"]
