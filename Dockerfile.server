# Multi-stage build for DNS Tunnel Server
FROM debian:bookworm-slim as builder

# Install dependencies for building Rust
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    build-essential \
    gcc \
    libc6-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install Rust using rustup (non-interactive)
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --default-toolchain stable && \
    chmod -R a+w $RUSTUP_HOME $CARGO_HOME

WORKDIR /app

# Copy manifest files
COPY Cargo.toml ./
COPY src ./src

# Cargo.lock will be generated automatically during build if it doesn't exist
# For reproducible builds, you can generate it first with: cargo generate-lockfile

# Build the server binary
RUN cargo build --release --bin server

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the binary from builder
COPY --from=builder /app/target/release/server /app/server

# Create config directory
RUN mkdir -p /app/config

# Expose DNS port (53) - requires privileged mode or NET_ADMIN capability
EXPOSE 53/udp

# Run as non-root by default (but port 53 requires root or capabilities)
USER 1000:1000

ENTRYPOINT ["/app/server"]
CMD ["--config", "/app/config/server-config.json"]
